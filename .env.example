# Copy to .env and edit as needed. Leave empty to use defaults.
# 复制为 .env 后按需修改。留空即使用默认值。

# ------------------------------ Upstream/上游 ------------------------------
# Your Open WebUI address. Must include http:// or https://; no trailing slash.
# 你的 Open WebUI 地址。必须带 http:// 或 https://，结尾不要带斜杠
OPEN_WEBUI_BASE_URL=http://localhost:8080

# Upstream API style: auto (auto-detect) / v1 (/api/v1 only) / legacy (/api only)
#   auto   - probes /api/v1/models then /api/models at startup; recommended
#   v1     - Open WebUI >= 0.6, OpenAI-compatible routes
#   legacy - older versions, internal /api routes
#
# 上游 API 风格：auto（自动探测）/ v1（仅 /api/v1）/ legacy（仅 /api）
#   auto   —— 启动时依次探测 /api/v1/models 与 /api/models，推荐
#   v1     —— Open WebUI >= 0.6，走 OpenAI 兼容路由
#   legacy —— 旧版本，走 /api 内部路由
UPSTREAM_API_STYLE=auto

# Set to false when the upstream uses a self-signed certificate.
# 上游使用自签证书时设为 false
UPSTREAM_VERIFY_SSL=true

# Whether httpx reads the system proxy env vars (HTTP_PROXY/HTTPS_PROXY/NO_PROXY).
# Set to false when the upstream is on the intranet/localhost while the system
# has a proxy configured.
#
# 是否让 httpx 读取系统代理环境变量（HTTP_PROXY/HTTPS_PROXY/NO_PROXY）
# 上游在内网或本机、而系统又配了代理时，设为 false
UPSTREAM_TRUST_ENV=true

# ------------------------------ Public service/对外服务 ------------------------------
# The listen address of this service. 0.0.0.0 = listen on all interfaces
# (server-side configuration only!).
# Note: this is NOT the API address a client should fill in. Clients use:
#   local access    http://127.0.0.1:8000/v1
#   LAN access      http://<machine-IP>:8000/v1
# Electron/Chromium clients connecting to 0.0.0.0 fail with net::ERR_ADDRESS_INVALID.
#
# 服务监听地址。0.0.0.0 = 监听所有网卡（仅服务端配置用！）
# 注意：这不是客户端要填的 API 地址。客户端请填：
#   本机访问   http://127.0.0.1:8000/v1
#   局域网访问 http://<本机IP>:8000/v1
# Electron/Chromium 客户端连 0.0.0.0 会报 net::ERR_ADDRESS_INVALID
PROXY_HOST=0.0.0.0
PROXY_PORT=8000

# The API key required to access this proxy. Leave empty to disable auth
# (trusted intranet only).
#
# 访问本代理所需的 Key。留空则不做鉴权（仅限可信内网）
PROXY_API_KEY=sk-your-custom-proxy-key

# Comma-separated origins allowed to call via CORS (browser direct access);
# leave empty = CORS disabled (default).
# Example: PROXY_CORS_ORIGINS=http://localhost:3000,https://ui.example.com
# Wildcard "*" allows any origin; not recommended in production.
#
# 允许跨域（浏览器直连）的来源列表，逗号分隔；留空 = 不启用 CORS（默认）
# 例：PROXY_CORS_ORIGINS=http://localhost:3000,https://ui.example.com
# 通配 "*" 允许任意来源，不建议在生产使用
#
# PROXY_CORS_ORIGINS=

# ------------------------------ Timeout/超时 ------------------------------
REQUEST_TIMEOUT=300
CONNECT_TIMEOUT=10

# ------------------------------ Credentials/凭证 ------------------------------
# Where captured credentials are stored; never commit it to version control.
# 抓取到的凭证存放位置，务必不要提交到版本库
SESSION_FILE=session.json

# Reasoning-effort cache: the proxy probes each model once (zero-token validation
# error) and reuses the cache unless the model list changes. Force a full
# re-probe with `python app.py --probe`.
#
# 思考挡位缓存：代理对每个模型探测一次（零 token 的校验报错），之后只要
# 模型列表不变就复用缓存。需要全量重探时运行 `python app.py --probe`。
REASONING_CACHE_FILE=reasoning_cache.json
# Concurrency of the probe requests / 探测请求的并发数
REASONING_PROBE_CONCURRENCY=4
# Per-model probe timeout (seconds) / 单个模型的探测超时（秒）
REASONING_PROBE_TIMEOUT=30
# How long /v1/models waits for a missing-model probe before answering without
# the reasoning field (0 = answer immediately, never wait).
#
# /v1/models 在缺失挡位时最多等待探测完成多久再应答
# （0 = 立即应答，从不等待）。
REASONING_PROBE_WAIT=5

# ------------------------------ Misc./其它 ------------------------------
# Model alias mapping (JSON object): client-requested model name -> actual
# upstream model name.
#
# 模型别名映射（JSON 对象）：客户端请求的模型名 -> 上游实际模型名
#
# MODEL_ALIASES={"gpt-4o": "gpt-4o-mini", "claude": "anthropic.claude-3-5-sonnet"}

# Log level: CRITICAL / ERROR / WARNING / INFO / DEBUG / TRACE
# TRACE applies only to uvicorn (prints full HTTP messages); this service logs
# at DEBUG.
#
# 日志级别：CRITICAL / ERROR / WARNING / INFO / DEBUG / TRACE
# TRACE 只对 uvicorn 生效（会打印完整 HTTP 报文），本服务日志按 DEBUG 处理
LOG_LEVEL=INFO
# DEBUG=true is equivalent to LOG_LEVEL=DEBUG.
# DEBUG=true 等价于 LOG_LEVEL=DEBUG
DEBUG=false

# ------------------------------ Browser login related/浏览器登录相关 ------------------------------
# Max time to wait for the manual login (seconds).
# 等待手动登录的最长时间（秒）
LOGIN_TIMEOUT=600
# How long to keep observing after credentials are captured before closing the
# browser (seconds), to grab the freshest token.
#
# 捕获到凭证后继续观察多久再关闭浏览器（秒），用于捞到最新的 Token
LOGIN_QUIET_PERIOD=6
# Whether to launch the browser headless (keep false: you need the window for
# the manual login).
#
# 是否无头启动浏览器（一般保持 false，需要看到窗口手动登录）
LOGIN_HEADLESS=false
