# Copy to .env and edit as needed. Leave empty to use defaults.
# 复制为 .env 后按需修改。留空即使用默认值。

# Read this first / 先读这里
# ---------------------------------------------------------------------------
# 1. Everything this proxy forwards travels with your captured browser
#    credentials. A leaked PROXY_API_KEY is therefore as bad as leaking your
#    Open WebUI login itself -- the /v1/* passthrough is limited to
#    PASSTHROUGH_ALLOW (see "Exposure" below), and widening it widens that.
# 2. session.json holds LIVE credentials once it exists. Keep it out of
#    backups, sync folders, screenshots and container images.
#
# 1. 本代理转发的一切都带着你抓到的浏览器凭证，因此代理 Key 泄露就等于
#    Open WebUI 登录态泄露——/v1/* 兜底透传受 PASSTHROUGH_ALLOW 约束
#    （见下方"暴露面"），放得越宽，泄露后的影响越大。
# 2. session.json 一旦存在就是**可用凭证**，不要放进备份、同步目录、
#    截图或容器镜像。

# ------------------------------ Upstream/上游 ------------------------------
# Your Open WebUI address. Must include http:// or https://; no trailing slash.
# Localhost and LAN addresses (http://192.168.x.x:3000) are first-class here. A
# non-loopback plain-http address is not refused -- it only produces one startup
# warning, because the credentials and the chat content cross that link in clear
# text.
#
# 你的 Open WebUI 地址。必须带 http:// 或 https://，结尾不要带斜杠。
# localhost 与局域网地址（http://192.168.x.x:3000）在这里都是一等公民。非回环的
# 明文 http 地址不会被拒绝——只会产生一条启动提示，因为凭证与对话内容会明文过网。
OPEN_WEBUI_BASE_URL=http://localhost:8080

# Upstream API style: auto (auto-detect) / v1 (/api/v1 only) / legacy (/api only)
#   auto   - probes /api/v1/models then /api/models at startup; recommended
#   v1     - Open WebUI >= 0.6, OpenAI-compatible routes
#   legacy - older versions, internal /api routes
#
# 上游 API 风格：auto（自动探测）/ v1（仅 /api/v1）/ legacy（仅 /api）
#   auto   —— 启动时依次探测 /api/v1/models 与 /api/models，推荐
#   v1     —— Open WebUI >= 0.6，走 OpenAI 兼容路由
#   legacy —— 旧版本，走 /api 内部路由
UPSTREAM_API_STYLE=auto

# Set to false when the upstream uses a self-signed certificate.
# 上游使用自签证书时设为 false
UPSTREAM_VERIFY_SSL=true

# Whether httpx reads the system proxy env vars (HTTP_PROXY/HTTPS_PROXY/NO_PROXY).
# Set to false when the upstream is on the intranet/localhost while the system
# has a proxy configured.
#
# 是否让 httpx 读取系统代理环境变量（HTTP_PROXY/HTTPS_PROXY/NO_PROXY）
# 上游在内网或本机、而系统又配了代理时，设为 false
UPSTREAM_TRUST_ENV=true

# ------------------------------ Public service/对外服务 ------------------------------
# The listen address of this service. 0.0.0.0 = listen on all interfaces
# (server-side configuration only!).
# Note: this is NOT the API address a client should fill in. Clients use:
#   local access    http://127.0.0.1:8000/v1
#   LAN access      http://<machine-IP>:8000/v1
# Electron/Chromium clients connecting to 0.0.0.0 fail with net::ERR_ADDRESS_INVALID.
#
# 服务监听地址。0.0.0.0 = 监听所有网卡（仅服务端配置用！）
# 注意：这不是客户端要填的 API 地址。客户端请填：
#   本机访问   http://127.0.0.1:8000/v1
#   局域网访问 http://<本机IP>:8000/v1
# Electron/Chromium 客户端连 0.0.0.0 会报 net::ERR_ADDRESS_INVALID
PROXY_HOST=0.0.0.0
PROXY_PORT=8000

# The API key required to access this proxy. Leave empty to disable auth
# (trusted intranet only).
#
# 访问本代理所需的 Key。留空则不做鉴权（仅限可信内网）
PROXY_API_KEY=sk-your-custom-proxy-key

# Optional: several named keys instead of one shared key, so a single client can
# be rotated or revoked on its own and the logs can tell callers apart. Format:
# comma-separated "name:key" entries (a bare entry is accepted and auto-named).
# PROXY_API_KEY keeps working alongside it.
#
# 可选：用多把具名 Key 代替单一共享 Key，使单个客户端可被独立轮换或撤销，
# 日志也能区分调用方。格式：逗号分隔的 "name:key"（不带名字的条目也可，会自动命名）。
# PROXY_API_KEY 与它并存生效。
#
# PROXY_API_KEYS=alice:sk-alice-key,bob:sk-bob-key

# Safety interlock: with PROXY_API_KEY empty the service refuses to start unless
# PROXY_HOST is a loopback address, so an unauthenticated proxy is never exposed to
# the whole network by accident. Set this to true only if that is really intended.
#
# 安全联锁：PROXY_API_KEY 为空时，除非 PROXY_HOST 是回环地址，否则服务拒绝启动，
# 避免"无鉴权代理"被意外暴露到整个网络。确需如此再显式设为 true。
ALLOW_INSECURE=false

# Comma-separated origins allowed to call via CORS (browser direct access);
# leave empty = CORS disabled (default).
# Example: PROXY_CORS_ORIGINS=http://localhost:3000,https://ui.example.com
# Wildcard "*" allows any origin; not recommended in production.
#
# 允许跨域（浏览器直连）的来源列表，逗号分隔；留空 = 不启用 CORS（默认）
# 例：PROXY_CORS_ORIGINS=http://localhost:3000,https://ui.example.com
# 通配 "*" 允许任意来源，不建议在生产使用
#
# PROXY_CORS_ORIGINS=

# ------------------------------ Timeout/超时 ------------------------------
REQUEST_TIMEOUT=300
CONNECT_TIMEOUT=10

# ------------------------------ Credentials/凭证 ------------------------------
# Where captured credentials are stored; never commit it to version control.
# This file is a LIVE credential (a working upstream session), not a sample:
# treat it like a password, keep it out of backups/sync, and delete it once the
# session it holds has been retired (after a re-login, the old one is useless).
#
# 抓取到的凭证存放位置，务必不要提交到版本库。
# 该文件是**可用凭证**（一个能直接使用的上游会话），不是示例文件：请像对待密码
# 一样保管，不要放进备份/同步目录；其中会话作废后（重新登录过）请删除该文件。
SESSION_FILE=session.json

# Per-model probe cache: the proxy asks each model what it really accepts
# (reasoning-effort levels, capabilities, request parameters) and reuses the cache
# until that model's engine fingerprint changes. Force a full re-probe with
# `python app.py --probe`.
#
# 逐模型探测缓存：代理会问每个模型它真正接受什么（思考挡位、能力、请求参数），
# 之后只要该模型的引擎指纹不变就复用缓存。需要全量重探时运行 `python app.py --probe`。
MODEL_PROBE_CACHE_FILE=model_probe_cache.json
# Concurrency of the probe requests / 探测请求的并发数
MODEL_PROBE_CONCURRENCY=4
# Per-model probe timeout (seconds) / 单个模型的探测超时（秒）
MODEL_PROBE_TIMEOUT=30
# How long /v1/models waits for a probe that is actually in flight before answering
# without the probed fields (0 = answer immediately, never wait).
#
# /v1/models 在确有探测飞行中时最多等待探测完成多久再应答
# （0 = 立即应答，从不等待）。
MODEL_PROBE_WAIT=5
# Whether the /v1/models envelope carries "x_open_webui" (the instance's own feature
# switches and its default model metadata template). Turn off for clients that reject
# unknown envelope keys.
#
# /v1/models 信封是否携带 "x_open_webui"（实例自身功能开关与默认模型元数据模板）。
# 对拒绝未知信封键的客户端可关闭。
EXPOSE_INSTANCE_META=true

# ------------------------------ Exposure / 暴露面 ------------------------------
# Reject JSON request bodies larger than this many bytes (413).
# 拒绝超过该字节数的 JSON 请求体（413）。
MAX_BODY_BYTES=10485760

# Seconds the upstream model list is reused before it is fetched again (0 = fetch on
# every request). Bounded staleness keeps polling clients from hammering the
# upstream's /models.
#
# 上游模型列表的复用秒数，超时后重新拉取（0 = 每次请求都拉取）。有界陈旧度可避免
# 轮询型客户端反复打上游 /models。
MODEL_LIST_TTL=10

# Whether upstream error bodies are quoted inside the client-facing error message;
# false (the default) keeps them in this service's log only, and the client gets a
# fixed message plus the request id that ties it to that log line.
#
# 是否把上游错误响应体原文放进返回给客户端的错误消息；默认 false 时细节只进本服务
# 日志，客户端收到固定文案 + 可用于对日志的 request id。
EXPOSE_UPSTREAM_ERROR=false

# The /v1/* catch-all passthrough forwards with your captured credentials, so it is
# allowlisted by default: only these subpaths (exact or subpath match) are forwarded.
# Default: images, audio, files, responses
#   PASSTHROUGH_ALLOW=*            -> unrestricted (the historical behavior)
#   PASSTHROUGH_ALLOW=             -> nothing is forwarded at all
#   PASSTHROUGH_ALLOW=responses,images -> exactly those
# Every entry you add hands whoever holds a proxy key whatever your account can do
# at that upstream route.
#
# /v1/* 兜底透传会带着你抓到的凭证转发，因此默认受白名单约束：只转发下列子路径
# （精确或子路径匹配）。默认：images、audio、files、responses
#   PASSTHROUGH_ALLOW=*            -> 不设限（历史上的行为）
#   PASSTHROUGH_ALLOW=             -> 一条都不转发
#   PASSTHROUGH_ALLOW=responses,images -> 恰好是这两条
# 每加一条，就等于把"你的账号在该上游路由上能做的一切"交给每一位代理 Key 持有者。
#
# PASSTHROUGH_ALLOW=*

# ------------------------------ Misc./其它 ------------------------------
# Model alias mapping (JSON object): client-requested model name -> actual
# upstream model name.
#
# 模型别名映射（JSON 对象）：客户端请求的模型名 -> 上游实际模型名
#
# MODEL_ALIASES={"gpt-4o": "gpt-4o-mini", "claude": "anthropic.claude-3-5-sonnet"}

# Log level: CRITICAL / ERROR / WARNING / INFO / DEBUG / TRACE
# TRACE applies only to uvicorn (prints full HTTP messages); this service logs
# at DEBUG.
#
# 日志级别：CRITICAL / ERROR / WARNING / INFO / DEBUG / TRACE
# TRACE 只对 uvicorn 生效（会打印完整 HTTP 报文），本服务日志按 DEBUG 处理
LOG_LEVEL=INFO
# DEBUG=true is equivalent to LOG_LEVEL=DEBUG.
# DEBUG=true 等价于 LOG_LEVEL=DEBUG
DEBUG=false

# ------------------------------ Browser login related/浏览器登录相关 ------------------------------
# Max time to wait for the manual login (seconds).
# 等待手动登录的最长时间（秒）
LOGIN_TIMEOUT=600
# How long to keep observing after credentials are captured before closing the
# browser (seconds), to grab the freshest token.
#
# 捕获到凭证后继续观察多久再关闭浏览器（秒），用于捞到最新的 Token
LOGIN_QUIET_PERIOD=6
# Whether to launch the browser headless (keep false: you need the window for
# the manual login).
#
# 是否无头启动浏览器（一般保持 false，需要看到窗口手动登录）
LOGIN_HEADLESS=false
